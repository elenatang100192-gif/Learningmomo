# 莫莫英语 - 环境变量示例

> 复制本文件为 `.env` 并填入真实值。**`.env` 不会提交到 Git**。

# ---------- 运行模式 ----------
NODE_ENV=development
PORT=3001

# ---------- 数据库 (MySQL) ----------
DB_HOSTNAME=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# ---------- 鉴权 ----------
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- 七牛云存储 ----------
QINIU_URL=
QINIU_BUCKET=
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_UPLOAD_HOST=https://upload.qiniup.com

# ---------- 阿里云 DashScope (通义千问 / Paraformer ASR) ----------
DASHSCOPE_API_KEY=

# ---------- 管理后台默认账号（首次启动时使用） ----------
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=ChangeMe123!

# ---------- CORS ----------
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002
